    "xing_hai": {
      "source_page": "PDF第29页（印刷第21页）",
      "source_text": "尾忌汤火及刀砧，轸水须忧丑未临。箕鬼氐房由忌子，心奎二宿百般寻。金狗从来未不宁，金牛角轸酉为刑。星张汤火忧寅上，危燕巳上莫相侵。觜参昴胃毕辰凶，井壁原来忌卯宫。",
      "entries": [
        {"birds": ["尾"], "targets": ["汤火", "刀"], "text": "尾忌汤火及刀砧"},
        {"birds": ["轸"], "targets": ["丑", "未"], "text": "轸水须忧丑未临"},
        {"birds": ["箕", "鬼", "氐", "房"], "targets": ["子"], "text": "箕鬼氐房由忌子"},
        {"birds": ["心", "奎"], "targets": [], "text": "心奎二宿百般寻"},
        {"birds": ["娄"], "targets": ["未"], "text": "金狗从来未不宁"},
        {"birds": ["牛", "角", "轸"], "targets": ["酉"], "text": "金牛角轸酉为刑"},
        {"birds": ["星", "张"], "targets": ["汤火", "寅"], "text": "星张汤火忧寅上"},
        {"birds": ["危"], "targets": ["巳"], "text": "危燕巳上莫相侵"},
        {"birds": ["觜", "参", "昴", "胃", "毕"], "targets": ["辰"], "text": "觜参昴胃毕辰凶"},
        {"birds": ["井", "壁"], "targets": ["卯"], "text": "井壁原来忌卯宫"}
      ]
    },
    "fuduan": {
      "source_book": "禽星易见",
      "source_page": "伏断",
      "source_text": "子虚丑斗寅嫌室，卯女辰箕巳泊房。午角未张申忌鬼，酉觜戌胃亥壁当。",
      "by_day_branch": {
        "子": "虚", "丑": "斗", "寅": "室", "卯": "女", "辰": "箕", "巳": "房",
        "午": "角", "未": "张", "申": "鬼", "酉": "觜", "戌": "胃", "亥": "壁"
      }
    }
  },
  "notes": [
    "时禽表按七曜分行，不按七元分表。",
    "水宿与土宿外锁泊共用一行，长生同在申。",
    "翻禽采用《演禽正传》从时辰起气将、顺数到时禽；辅助资料的日禽起法只作差异展示。"
